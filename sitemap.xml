---
layout: null
sitemap: false
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  <!-- Home -->
  <url>
    <loc>{{ site.url }}/</loc>
    <lastmod>{{ site.time | date: '%Y-%m-%d' }}</lastmod>
    <changefreq>weekly</changefreq>
    <priority>1.0</priority>
  </url>

  <!-- Archive -->
  <url>
    <loc>{{ site.url }}/archive/</loc>
    <lastmod>{{ site.time | date: '%Y-%m-%d' }}</lastmod>
    <changefreq>weekly</changefreq>
    <priority>0.7</priority>
  </url>

  <!-- Topic and utility pages -->
  {% assign topic_pages = site.pages | where_exp: "item", "item.url != '/' and item.url != '/archive/'" %}
  {% for topic_page in topic_pages %}
  {% unless topic_page.sitemap == false %}
  {% if topic_page.title and topic_page.url %}
  <url>
    <loc>{{ site.url }}{{ topic_page.url }}</loc>
    <lastmod>{{ site.time | date: '%Y-%m-%d' }}</lastmod>
    <changefreq>weekly</changefreq>
    <priority>0.7</priority>
  </url>
  {% endif %}
  {% endunless %}
  {% endfor %}

  <!-- Posts -->
  {% for post in site.posts %}
  {% unless post.sitemap == false %}
  {% unless post.canonical_url %}
  <url>
    <loc>{{ site.url }}{{ post.url }}</loc>
    <lastmod>{{ post.date | date: '%Y-%m-%d' }}</lastmod>
    <changefreq>monthly</changefreq>
    <priority>0.8</priority>
  </url>
  {% endunless %}
  {% endunless %}
  {% endfor %}
</urlset>
