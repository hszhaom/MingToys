---
layout: null
sitemap: false
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  {% assign content_pages = site.pages | where: "layout", "default" %}
  {% for item in content_pages %}
  {% unless item.sitemap == false or item.canonical_url or item.noindex %}
  {% assign item_lastmod = item.updated | default: item.date %}
  <url>
    <loc>{{ site.url }}{{ item.url }}</loc>
    {% if item_lastmod %}<lastmod>{{ item_lastmod | date: '%Y-%m-%d' }}</lastmod>{% endif %}
  </url>
  {% endunless %}
  {% endfor %}

  {% for post in site.posts %}
  {% unless post.sitemap == false or post.canonical_url or post.noindex %}
  {% assign post_lastmod = post.updated | default: post.date %}
  <url>
    <loc>{{ site.url }}{{ post.url }}</loc>
    <lastmod>{{ post_lastmod | date: '%Y-%m-%d' }}</lastmod>
  </url>
  {% endunless %}
  {% endfor %}
</urlset>
