---
layout: null
sitemap: false
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  {% assign content_pages = site.pages | where: "layout", "default" %}
  {% for item in content_pages %}
  {% unless item.sitemap == false or item.canonical_url %}
  <url>
    <loc>{{ site.url }}{{ item.url }}</loc>
    {% if item.updated %}<lastmod>{{ item.updated | date: '%Y-%m-%d' }}</lastmod>{% endif %}
  </url>
  {% endunless %}
  {% endfor %}

  {% for post in site.posts %}
  {% unless post.sitemap == false or post.canonical_url %}
  {% assign owner_guidance = site.data.breed_owner_guidance[post.slug] %}
  {% assign post_modified = owner_guidance.updated | default: post.updated | default: post.date %}
  <url>
    <loc>{{ site.url }}{{ post.url }}</loc>
    <lastmod>{{ post_modified | date: '%Y-%m-%d' }}</lastmod>
  </url>
  {% endunless %}
  {% endfor %}
</urlset>
